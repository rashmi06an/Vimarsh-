# Mobile env. Copy to mobile/.env and set your laptop's LAN IP for real-device / APK builds.
# Expo inlines EXPO_PUBLIC_* at build time. In Expo Go dev, if this is unset the app
# auto-derives the host from the Metro bundler, so you usually only need this for the APK.
#
# Find your laptop LAN IP:  macOS -> `ipconfig getifaddr en0`  (or System Settings > Wi-Fi)
# Example: 192.168.1.50
EXPO_PUBLIC_API_URL=http://192.168.1.50:4000
