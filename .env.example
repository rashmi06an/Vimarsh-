# ============================================================================
# Vimarsh environment template. Copy to .env and fill real values.
# .env is gitignored. NEVER commit real secrets. Placeholders below are safe.
# ============================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Database (MongoDB single-node replica set; required by Prisma) ----
DATABASE_URL=mongodb://localhost:27017/vimarsh?replicaSet=rs0

# ---- Seed bootstrap Super Admin (used by `npm run seed`) ----
# Dev defaults exist in the seed script, but set these for anything beyond local dev.
# In production the seed refuses to run without SEED_SUPER_ADMIN_PASSWORD.
SEED_SUPER_ADMIN_EMAIL=admin@aicte.vimarsh.local
SEED_SUPER_ADMIN_PASSWORD=Admin@12345

# ---- JWT ----
# Use long random strings in real environments (e.g. `openssl rand -hex 48`).
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars_long
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars_long
ACCESS_TTL=900            # access token lifetime, seconds (15 min)
REFRESH_TTL=1209600       # refresh token lifetime, seconds (14 days)

# ---- Throttling / lockout ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OTP_TTL_SECONDS=600       # OTP valid for 10 minutes
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60    # seconds between OTP resends

# ---- Email / SMTP (OTP delivery) ----
# Leave SMTP_HOST empty for local dev: OTP is logged to the backend console
# ONLY when SMTP_HOST is empty AND NODE_ENV=development (development-only fallback).
# In production an empty SMTP_HOST is a hard misconfiguration (startup warns loudly).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AICTE Vimarsh <no-reply@vimarsh.local>"

# ---- LiveKit (media SFU) ----
# These MUST match livekit/livekit.yaml keys. Secret stays server-side only.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_please_32chars_min

# ---- Object storage (MinIO / S3-compatible) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=vimarsh
S3_SECRET_KEY=vimarsh-secret
S3_BUCKET=vimarsh-private
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL=300        # presigned URL lifetime, seconds (5 min)
# The LiveKit Egress container reaches MinIO on the docker network, not localhost.
LIVEKIT_EGRESS_S3_ENDPOINT=http://minio:9000
# NOTE: for downloads from a physical phone, S3_ENDPOINT must be a host the phone can reach
# (e.g. your Mac's LAN IP, http://192.168.x.x:9000). localhost only works on the simulator.

# ---- Optional providers (honest "not configured" checks; never silently faked) ----
SMS_PROVIDER=             # empty = disabled
PUSH_PROVIDER=            # empty = disabled (in-app notifications always work)
MALWARE_SCANNER=          # empty = disabled (uploads flagged scanStatus=SKIPPED)

# ---- Uploads ----
MAX_UPLOAD_MB=25

# ---- Encryption at rest (documents) ----
# AES-256-GCM key for encrypting uploaded documents at rest. 32 bytes, as 64 hex chars
# (or base64 of 32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED for document upload/download. Keep it only in .env (never commit the real value).
# Losing/rotating this key makes previously uploaded documents undecryptable.
DOCUMENT_ENCRYPTION_KEY=replace-with-64-hex-chars-from-the-command-above

# ---- CORS / client origins ----
CORS_ORIGINS=*
